              }
            ],
            "title": "School"
          },
          "avatar_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Id"
          }
        },
        "additionalProperties": false,
