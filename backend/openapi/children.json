            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "age",
          "gender",
          "school",
          "avatar_id",
          "avatar_url",
          "progress",
          "created_at",
          "updated_at"
        ],
        "title": "Child"
      },
      "ChildIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "age": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 25.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "school": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "School"
          },
          "avatar_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
