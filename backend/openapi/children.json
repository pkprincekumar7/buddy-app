            "type": "string",
            "enum": [
              "focus",
              "curious",
              "order",
              "draw",
              "climb",
              "voice",
              "energy"
            ],
            "title": "Game"
          },
          "seconds": {
            "type": "number",
            "maximum": 600.0,
            "minimum": 0.5,
            "title": "Seconds"
