        "additionalProperties": false,
        "type": "object",
        "title": "ChildPatch",
        "description": "Any subset; `null` clears an optional field. `avatar_id` and `avatar_key` exclude each other."
      },
      "FlipPower": {
        "properties": {
          "type": {
            "type": "string",
