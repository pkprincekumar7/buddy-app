            ],
            "title": "Age"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "school": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
