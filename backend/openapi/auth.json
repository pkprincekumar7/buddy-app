    "/api/v1/auth/accounts/{id}/lock": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Lock Account",
        "description": "Lock an account: signed out everywhere, login blocked. Admins (`accounts:lock`); audited. Not yourself, and not the last active admin.",
        "operationId": "lock_account_api_v1_auth_accounts__id__lock_post",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The account's user id",
              "title": "Id"
            },
            "description": "The account's user id"
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,16}$",
              "description": "The account's location, from the listing",
              "title": "Location"
            },
            "description": "The account's location, from the listing"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
