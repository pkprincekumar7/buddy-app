            "description": "The account's user id"
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,16}$",
              "description": "The account's location, from the listing",
              "title": "Location"
            },
            "description": "The account's location, from the listing"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
