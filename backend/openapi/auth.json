    "/api/v1/auth/account": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Delete Account",
        "description": "Delete your account and all your data, through the deletion saga. Signs you out everywhere at once; the data goes as each service confirms.",
        "operationId": "delete_account_api_v1_auth_account_delete",
        "requestBody": {
          "content": {
            "application/json": {
