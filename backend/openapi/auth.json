        ],
        "summary": "Remove Allowed Email",
        "description": "Remove an entry by its HMAC key (so no email is in the URL). Existing accounts aren't affected. Admins (`allowed_emails:write`); audited.",
        "operationId": "remove_allowed_email_api_v1_auth_allowed_emails__key__delete",
        "security": [
          {
            "APIKeyCookie": []
