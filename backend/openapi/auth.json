      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Unlock Account",
        "description": "Unlock an account. `tokens_revoked_at` stays, so tokens from before the lock stay invalid: the user signs in again. Admins (`accounts:lock`); audited.",
        "operationId": "unlock_account_api_v1_auth_accounts__id__unlock_post",
        "security": [
          {
            "APIKeyCookie": []
