    "/api/v1/children/{id}/growth-areas": {
      "get": {
        "tags": [
          "growth-areas"
        ],
        "summary": "List Areas",
        "description": "Every growth area of the child, in the order they were started, with `generating` naming the kinds with a job running. An admin with `children:read:any` passes the owner's `?location=` (audited).",
        "operationId": "list_areas_api_v1_children__id__growth_areas_get",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "The child's id",
              "title": "Id"
            },
            "description": "The child's id"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,16}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The owner's location (admins only)",
              "title": "Location"
            },
            "description": "The owner's location (admins only)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Areas"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/children/{id}/growth-areas/{area_id}": {
      "put": {
        "tags": [
          "growth-areas"
        ],
        "summary": "Save Area",
        "description": "Save one area: the parent's progress through its wizard, and its completion (`grow.area_completed`, and `grow.completed` for the child's first). Editing a completed area publishes `grow.area_updated`; a completed area stays completed (a save sending `in_progress` is an edit of it). Answer keys must be ids from the area's `parent_questions`; the generated parts can't be sent.",
        "operationId": "save_area_api_v1_children__id__growth_areas__area_id__put",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "The child's id",
              "title": "Id"
            },
            "description": "The child's id"
          },
          {
            "name": "area_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,50}$",
              "description": "The area's id (today's: `self_care`, `life_ambition`, \u2026); never starting with onboarding, personality, growth-areas, transform, observations, connect",
              "title": "Area Id"
            },
            "description": "The area's id (today's: `self_care`, `life_ambition`, \u2026); never starting with onboarding, personality, growth-areas, transform, observations, connect"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AreaIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Area"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/children/{id}/growth-areas/{area_id}/generation": {
      "post": {
        "tags": [
          "growth-areas"
        ],
        "summary": "Start Generation",
        "description": "Generate one of the area's AI parts (`kind`). `parent_questions` on a new area creates it (with `area_name`). The question sets are generated once (`409 already_generated`). Recommendations need the parent's answers saved or a run of the area's world (`409 needs_input`), are written from both, and replace the last ones; the area's `recommendations_run_at` is the run they used, and its `recommendations_current` says whether they're from its present answers and feedback. An answered area is completed by its recommendations' job (`grow.area_completed`, and `grow.completed` for the child's first). The running job is returned with `200`. Counts against the hourly LLM limit (`429 llm_limit`).",
        "operationId": "start_generation_api_v1_children__id__growth_areas__area_id__generation_post",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "The child's id",
              "title": "Id"
            },
            "description": "The child's id"
          },
          {
            "name": "area_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,50}$",
              "description": "The area's id (today's: `self_care`, `life_ambition`, \u2026); never starting with onboarding, personality, growth-areas, transform, observations, connect",
              "title": "Area Id"
            },
            "description": "The area's id (today's: `self_care`, `life_ambition`, \u2026); never starting with onboarding, personality, growth-areas, transform, observations, connect"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationIn"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Started"
                }
              }
            }
          },
          "200": {
            "description": "The job already running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Started"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
