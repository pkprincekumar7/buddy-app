    "/api/v1/users/profiles": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "List Profile Names",
        "description": "Names for a page of accounts, for the admin account list. Ids with no profile are left out. Admins only (`profiles:read:any`); audited with the ids.",
        "operationId": "list_profile_names_api_v1_users_profiles_get",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "1\u2013100 comma-separated user ids",
              "title": "Ids"
            },
            "description": "1\u2013100 comma-separated user ids"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileNames"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}/profile": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Get Profile",
        "description": "A user's names and address: your own (`me`), or anyone's with `profiles:read:any` and `?location=`.",
        "operationId": "get_profile_api_v1_users__user_id__profile_get",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The user's id, or `me` for your own",
              "title": "User Id"
            },
            "description": "The user's id, or `me` for your own"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,16}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The owner's location, from the account listing. Required when an admin reads or changes someone else's data; ignored for your own.",
              "title": "Location"
            },
            "description": "The owner's location, from the account listing. Required when an admin reads or changes someone else's data; ignored for your own."
          }
