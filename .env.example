# ============================================================
# Superpower — root .env (Docker Compose)
# ============================================================
# Copy this file to .env and fill in the values.
# This file is read by Docker Compose for ${VAR} substitution.
# ============================================================

# ------------------------------------------------------------
# Exposed host ports (change if defaults clash with other services)
# ------------------------------------------------------------
FRONTEND_PORT=5173
MONGO_PORT=27017
VALKEY_PORT=6379
# The local API gateway (local/gateway/nginx.conf): http://localhost:8088/api/...
GATEWAY_PORT=8088
# Only for `docker compose --profile moto`; moto_server from the venv takes -p instead.
# Not 5000: macOS's AirPlay Receiver holds it.
MOTO_PORT=5050

# ------------------------------------------------------------
# MongoDB: the `mongo` Compose service, MongoDB 8.0 as a single-node replica set (change
# streams and transactions need one). Each service has its own database on it, named after
# the service. Automated tests never run against Atlas: its free tier allows 100 operations a
# second. From the host: mongodb://localhost:27017/?directConnection=true
#
# Manual mode (plain `docker compose up -d`, docs/getting-started.md "Manual and test modes"):
# your own Atlas project, one user per service (superpower-local-<service>, readWrite plus
# collMod on its own database). Unset, a service uses the `mongo` container, as in test mode.
# ------------------------------------------------------------
# AUTH_MONGODB_URI=
# USERS_MONGODB_URI=
# CHILDREN_MONGODB_URI=
# ONBOARDING_MONGODB_URI=
# DISCOVER_MONGODB_URI=
# GROW_MONGODB_URI=
# TRANSFORM_MONGODB_URI=
# RELEASE_MONGODB_URI=

# ------------------------------------------------------------
# JWT — required
# Generate a 2048-bit RSA key pair and format it for this .env file:
#
#   openssl genrsa -out jwt_private.pem 2048
#   awk 'NF {sub(/\r/,""); printf "%s\\n",$0}' jwt_private.pem
#
# Paste the single-line output (everything on one line, \n as literal escapes) as the value of
# JWT_PRIVATE_KEY below. Docker Compose does not support multiline .env values: auth turns the
# \n escapes back into newlines at startup. Only auth holds the private key; local-keys derives
# the public keys every other service verifies with (JWT_PUBLIC_KEYS).
#
# To derive the public key (required as the JWT_PUBLIC_KEYS GitHub environment variable —
# public keys aren't secret — for the infra-live-edge Terraform workflow):
#
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#   awk 'NF {sub(/\r/,""); printf "%s\\n",$0}' jwt_public.pem
#
# Store as a JSON map in the JWT_PUBLIC_KEYS GitHub environment variable:
#   {"key-v1": "<single-line output from awk above>"}
#
# See docs/jwt-keys.md for the full setup and key rotation procedure.
# ------------------------------------------------------------
JWT_PRIVATE_KEY=
JWT_KEY_ID=key-v1

# ------------------------------------------------------------
# LLM providers — set at least one key to enable generation (the discover, grow, transform
# and release workers). Auto-selection priority (first key found wins): OpenAI → Anthropic →
# Gemini. LLM_HOURLY_LIMIT is each user's generations an hour, across every circle.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash

LLM_TIMEOUT_SECONDS=60
LLM_HOURLY_LIMIT=200

# ------------------------------------------------------------
# Google Sign-In — OAuth 2.0 Web client ID
# Leave empty to hide the Google button on login and return 503 from POST /auth/google.
# Both values must match (GOOGLE_CLIENT_ID verified by auth, VITE_ baked into the frontend image).
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# Valkey: the `valkey` Compose service (rate limits, the authz cache, leader locks).
# Image for it: Docker Desktop's org policy here blocks valkey/valkey, so use the
# protocol-compatible official Redis image locally; CI uses the real Valkey.
# ------------------------------------------------------------
VALKEY_IMAGE=redis:7-alpine

# ------------------------------------------------------------
# Local AWS (SNS, SQS, S3) — Moto: the compose `moto` service, set up by `moto-setup` on
# every `docker compose up`; the services reach it at http://moto:5000, the host at
# http://localhost:5050 (MOTO_PORT).
#
# LOCAL_MOTO_URL is what the services call for SNS, SQS and the rest (Moto in both modes).
# LOCAL_S3_URL is what they call for S3, and LOCAL_S3_PUBLIC_URL what a presigned photo URL
# points at, so the browser on this machine can open it. Both default to Moto; in manual
# mode set both EMPTY (not commented out) and S3 is AWS's, through the regional endpoint.
# ------------------------------------------------------------
# LOCAL_MOTO_URL=http://moto:5000
# LOCAL_S3_URL=
# LOCAL_S3_PUBLIC_URL=

# ------------------------------------------------------------
# AWS credentials. Moto's fake keys by default. In manual mode set both keys EMPTY, and the
# services use LOCAL_AWS_PROFILE from LOCAL_AWS_DIR (your ~/.aws, mounted read-only). The
# access key stays in ~/.aws, never here. Its IAM policy: local/aws-manual/README.md.
# ------------------------------------------------------------
# LOCAL_AWS_ACCESS_KEY_ID=
# LOCAL_AWS_SECRET_ACCESS_KEY=
# LOCAL_AWS_PROFILE=superpower-local
# LOCAL_AWS_DIR=~/.aws

# ------------------------------------------------------------
# S3
# ASSETS_BUCKET_NAME — pre-existing bucket that holds static assets under the app-assets/
# prefix, served in production via CloudFront /app-assets/*. Locally the frontend container
# (and the Vite dev server) proxy /app-assets/* to it, which the phone app's CDN_BASE_URL
# reads too, and the shared service reads it for the APK link. Your local bucket's
# app-assets/* is public on purpose (local/aws-manual/README.md). Empty: no images locally.
# UPLOADS_BUCKET_NAME — user-generated content (child photos, plan photos), in Moto locally.
# Photos are private and shown through presigned GET URLs (EDGE-05); optional URL lifetime
# (default 3600 s): UPLOADS_URL_TTL_SECONDS.
# See docs/static-assets.md for the one-time bucket setup in AWS.
# ------------------------------------------------------------
ASSETS_BUCKET_NAME=person-local-assets-bucket
UPLOADS_BUCKET_NAME=person-local-uploads-bucket-ap-south-1
# UPLOADS_URL_TTL_SECONDS=3600

# ------------------------------------------------------------
# Frontend Vite build args (Docker Compose passes these at `docker compose build`)
# VITE_API_URL — leave blank so nginx proxies /api to the gateway on the same origin.
# FRONTEND_API_UPSTREAM — where the frontend container's nginx sends /api (default gateway:8080).
# ------------------------------------------------------------
# VITE_API_URL=
# FRONTEND_API_UPSTREAM=gateway:8080

# ------------------------------------------------------------
# auth
# EMAIL_HMAC_PEPPER — the email HMAC pepper (docs/auth-users-split.md 6.4): generate with
# `openssl rand -hex 32`. Keep it: losing it makes every stored email key unmatchable.
# LOCAL_ALLOWED_EMAIL — an email `python -m auth.seed` (run in the auth container) adds to the
# local allow-list (APP_ENV=local only), so local registration works end to end. Never commit
# a real address.
# ------------------------------------------------------------
EMAIL_HMAC_PEPPER=
LOCAL_ALLOWED_EMAIL=
