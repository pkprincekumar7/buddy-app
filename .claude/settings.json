{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/Pods/**)",
      "Read(**/vendor/bundle/**)",

      "Read(**/dist/**)",
      "Read(**/dist-ssr/**)",
      "Read(**/build/**)",
      "Read(**/web-build/**)",
      "Read(**/.expo/**)",
      "Read(**/.gradle/**)",
      "Read(**/.cxx/**)",
      "Read(**/.kotlin/**)",
      "Read(**/DerivedData/**)",
      "Read(**/xcuserdata/**)",
      "Read(**/*.xcworkspace/**)",
      "Read(**/*.jsbundle)",

      "Read(**/__pycache__/**)",
      "Read(**/*.pyc)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.vite/**)",
      "Read(**/htmlcov/**)",
      "Read(**/coverage/**)",
      "Read(**/.coverage)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/.metro-health-check*)",
      "Read(**/mutants/**)",

      "Read(**/.terraform/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/tfplan*.bin)",
      "Read(**/*.zip)",

      "Read(**/sbom-*.cyclonedx.json)",
      "Read(**/retire-jsrepo.json)",
      "Read(**/.docx_extract/**)",

      "Read(**/*.mp3)",
      "Read(**/*.ttf)",
      "Read(**/*.otf)",
      "Read(**/*.woff)",
      "Read(**/*.woff2)",
      "Read(**/*.jar)",
      "Read(**/*.apk)",
      "Read(**/*.aab)",
      "Read(**/*.ipa)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",

      "Read(**/.idea/**)",
      "Read(**/.DS_Store)",
      "Read(**/.claude/worktrees/**)"
    ]
  }
}
