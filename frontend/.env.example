# Copy to `frontend/.env` for local frontend-only development (without Docker).
# When running via Docker Compose, Vite vars are passed as build args — this file is ignored there.
#
# Google Sign-In: OAuth 2.0 *Web client ID*. Must match GOOGLE_CLIENT_ID in the root .env (auth).
# Leave empty to hide the Google Sign-In button on the login page.
VITE_GOOGLE_CLIENT_ID=
#
# API base URL (optional). Leave empty to use the Vite dev-server proxy (/api → the local
# gateway on localhost:8088, which routes to the services; API_PROXY_TARGET changes it).
# Set to a full URL when the API is on a different origin, e.g. https://api.example.com
# VITE_API_URL=
#
# App assets: an environment's CloudFront site. When set, the Vite dev-server proxies
# /app-assets/* to it so local dev can load images (the assets bucket itself only lets
# CloudFront read it). Empty: /app-assets/* 404s and the app shows its fallback tiles.
ASSETS_ORIGIN=
