{
  "name": "superpower-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "COVERAGE=1 playwright test",
    "test:e2e:ci": "SLOWMO=0 COVERAGE=1 playwright test && node e2e/coverage-floor.mjs",
    "test:e2e:shard": "SLOWMO=0 COVERAGE=1 COVERAGE_RAW=1 playwright test",
    "test:e2e:merge": "node e2e/coverage-merge.mjs",
    "preview": "vite preview",
    "prepare": "cd .. && ([ -d .git ] && husky frontend/.husky || true)"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.107.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lodash": "^4.17.21",
    "lucide-react": "^1.74.0",
    "next-themes": "^0.4.4",
    "openapi-fetch": "0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@stoplight/spectral-cli": "6.17.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "31.0.1",
    "lint-staged": "^17.6.1",
    "monocart-reporter": "2.15.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "retire": "^6.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@asyncapi/specs": "6.11.1",
    "@asyncapi/generator": "3.3.0",
    "@asyncapi/generator-helpers": "1.1.0",
    "@asyncapi/generator-components": "0.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "dompurify": "^3.4.16",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1",
    "basic-ftp": "^6.2.1",
    "postcss-selector-parser": "^7.1.6"
  }
}
