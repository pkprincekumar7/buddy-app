# ============================================================
# Superpower — test mode (committed: no secrets, only local addresses)
# ============================================================
# Layered over .env, so the stack keeps .env's keys (JWT, pepper, LLM keys) but runs on the
# local stand-ins: the `mongo` container and Moto for S3, SNS and SQS. The e2e runs need it
# (scripts/e2e refuses any other stack), and nothing here can reach Atlas or AWS:
#
#   docker compose --env-file .env --env-file .env.test up -d
#
# Plain `docker compose up -d` is the manual mode: .env's Atlas URIs and real S3 bucket.
# See docs/getting-started.md, "Manual and test modes".
# ============================================================

# Every service on the local replica set, each in its own database (MONGODB_DB_NAME).
AUTH_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
USERS_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
CHILDREN_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
ONBOARDING_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
DISCOVER_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
GROW_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
TRANSFORM_MONGODB_URI=mongodb://mongo:27017/?directConnection=true
RELEASE_MONGODB_URI=mongodb://mongo:27017/?directConnection=true

# S3 on Moto, as the services call it and as the browser opens the presigned photo URLs.
LOCAL_S3_URL=http://moto:5000
LOCAL_S3_PUBLIC_URL=http://localhost:5050
# Moto's buckets (scripts/local-aws-setup.py creates them).
UPLOADS_BUCKET_NAME=person-local-uploads-bucket-ap-south-1
ASSETS_BUCKET_NAME=person-local-assets-bucket

# Moto accepts any credentials: the fake ones, with an empty profile (local/aws-test).
LOCAL_AWS_ACCESS_KEY_ID=local
LOCAL_AWS_SECRET_ACCESS_KEY=local
LOCAL_AWS_PROFILE=default
LOCAL_AWS_DIR=./local/aws-test
