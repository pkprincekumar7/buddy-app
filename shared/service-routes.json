{
  "description": "Public API path → service, in ALB priority order (docs/auth-users-split.md, 13.1). The single source for the AWS ALB rules (infra-live-backend, build plan 2.5) and the local gateway (local/gateway/nginx.conf, generated by scripts/sync-gateway.mjs). Patterns use the ALB's syntax: * matches any characters, including /. A rule with \"built\": false isn't routed yet.",
  "port": 8000,
  "rules": [
    { "priority": 10, "service": "onboarding", "paths": ["/api/v1/children/*/onboarding*"] },
    { "priority": 20, "service": "discover", "paths": ["/api/v1/children/*/personality*"] },
    { "priority": 30, "service": "grow", "paths": ["/api/v1/children/*/growth-areas*"] },
    { "priority": 40, "service": "transform", "paths": ["/api/v1/children/*/transform*"] },
    { "priority": 50, "service": "release", "paths": ["/api/v1/children/*/observations*"] },
    {
      "priority": 60,
      "service": "connect",
      "paths": ["/api/v1/children/*/connect*"],
      "built": false
    },
    { "priority": 100, "service": "children", "paths": ["/api/v1/children", "/api/v1/children/*"] },
    { "priority": 110, "service": "users", "paths": ["/api/v1/users/*"] },
    { "priority": 120, "service": "auth", "paths": ["/api/v1/auth/*"] },
    { "priority": 130, "service": "shared", "paths": ["/api/v1/speech/*", "/api/v1/downloads/*"] },
    { "priority": 140, "service": "shared", "paths": ["/api/health"] }
  ]
}
