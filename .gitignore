.env
.env.local
.env.*.local
node_modules/
__pycache__/
.venv/
venv/
dist/
*.egg-info/
backend/common/build/
*.pyc
.DS_Store
.docx_extract/
.mypy_cache/
.ruff_cache/
.claude/worktrees/

# Test coverage artefacts (generated by pytest-cov)
.coverage
htmlcov/

# SBOM generated locally by check.sh (trivy image scan)
sbom-*.cyclonedx.json

# retire.js vulnerability database — auto-downloaded by check.sh bootstrap;
# gitignored so it stays current without committing a static snapshot.
frontend/retire-jsrepo.json

# Local RSA key pair — never commit private keys
*.pem

# Terraform-generated Lambda zips — rebuilt on every plan/apply
infra-live-edge/terraform/*.zip
infra-live-scheduler/lambda/*.zip

# mutmut working copy (backend mutation testing)
backend/mutants/

# Terraform provider caches (local init)
.terraform/

# Shared Terraform modules (TF-01) are init'ed only to run their tests; the
# provider lock file belongs to the root stacks that call them.
modules/*/.terraform.lock.hcl
